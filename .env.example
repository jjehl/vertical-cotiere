# Préférer : node scripts/init-env.mjs (crée les secrets et conserve un .env existant).
# Identifiants locaux générés en hexadécimal par init-env.mjs.
S3_PORT=8333
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
WEB_PORT=3000
CMS_PORT=1337
DATABASE_PASSWORD=
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=
# Facultatif : assistant de publication, clé uniquement côté serveur Strapi.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-4

# Connexion membre Google (client OAuth « Application Web », secrets côté CMS).
# URI de redirection : PUBLIC_SITE_URL + /api/member/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envoi réel via une boîte OVH MX Plan, y compris en local.
# SMTP_USER = adresse e-mail complète, SMTP_PASSWORD = mot de passe de cette boîte.
# EMAIL_FROM vide utilise SMTP_USER. Conserver PUBLIC_SITE_URL sur localhost en local.
PUBLIC_SITE_URL=http://localhost:3000
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# HelloAsso Checkout : secrets côté CMS uniquement. Sandbox par défaut.
# Le paiement nécessite PUBLIC_SITE_URL en HTTPS et les droits Checkout de l’association.
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORGANIZATION_SLUG=vertical-cotiere
HELLOASSO_SANDBOX=true
# Secret aléatoire à ajouter à l’URL de notification HelloAsso (voir documentation/17-inscriptions.md).
HELLOASSO_WEBHOOK_TOKEN=
