IMAGE_PREFIX=ghcr.io/jjehl/vertical-cotiere
# Exemple : sha-<SHA Git complet> ou v0.1.0 ; utiliser le même tag pour les deux images.
IMAGE_TAG=
DATABASE_PASSWORD=
APP_KEYS=
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
JWT_SECRET=
# Renseignée automatiquement par le workflow depuis le secret GitHub production/MISTRAL_API_KEY.
# Laisser vide ici : aucune valeur réelle dans le dépôt ou les images.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-8b-2512
# CMS privé via tunnel SSH pour cette première version.
PUBLIC_CMS_URL=http://localhost:1337
# Mettre true au premier démarrage pour importer le contenu public repris, puis false.
SEED_CONTENT=false
# Sur base vierge : true avec SEED_CONTENT=true et la galerie source, puis false.
IMPORT_MEDIA=false
GALLERY_DIRECTORY=/srv/vertical-cotiere/gallery
SITE_DOMAIN=vertical-cotiere.fr
TRAEFIK_NETWORK=traefik
TRAEFIK_CERT_RESOLVER=myresolver
