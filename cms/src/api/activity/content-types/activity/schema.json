{
  "kind": "collectionType",
  "collectionName": "activitys",
  "info": {
    "singularName": "activity",
    "pluralName": "activitys",
    "displayName": "Activité"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "eyebrow": {
      "type": "string"
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "body": {
      "type": "text"
    },
    "image": {
      "type": "string",
      "private": true,
      "pluginOptions": {
        "content-manager": {
          "visible": false
        },
        "content-type-builder": {
          "visible": false
        }
      }
    },
    "audience": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "attachments": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    }
  }
}
