{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page et ressources"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "bodyHtml": {
      "type": "text"
    },
    "group": {
      "type": "string"
    },
    "oldPath": {
      "type": "string"
    },
    "sourceId": {
      "type": "string"
    },
    "structuredData": {
      "type": "json",
      "private": true,
      "pluginOptions": {
        "content-manager": {
          "visible": false
        },
        "content-type-builder": {
          "visible": false
        }
      }
    },
    "attachments": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "documents": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::club-document.club-document",
      "inversedBy": "pages"
    }
  }
}
