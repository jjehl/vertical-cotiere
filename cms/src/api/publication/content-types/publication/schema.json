{
  "kind": "collectionType",
  "collectionName": "publications",
  "info": {
    "singularName": "publication",
    "pluralName": "publications",
    "displayName": "Publication"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "body": {
      "type": "text"
    },
    "photos": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "attachments": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "files"
      ]
    },
    "meeting": {
      "type": "component",
      "repeatable": false,
      "component": "publications.meeting"
    },
    "category": {
      "type": "string",
      "default": "Vie du club"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "date": {
      "type": "datetime"
    },
    "legacyKey": {
      "type": "string",
      "private": true,
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    },
    "legacyType": {
      "type": "enumeration",
      "enum": [
        "article",
        "event",
        "album"
      ],
      "private": true,
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    },
    "legacySlug": {
      "type": "string",
      "private": true,
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    },
    "legacyBody": {
      "type": "text",
      "private": true,
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    },
    "legacyHtml": {
      "type": "text",
      "private": true,
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    },
    "legacySummary": {
      "type": "text",
      "private": true,
      "pluginOptions": {
        "content-manager": {
          "visible": false
        }
      }
    }
  }
}
