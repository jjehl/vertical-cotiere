# Copier dans .env.content-sync (ignoré par Git). Node.js >= 22.9 requis.
# sync-site.sh : tous les contenus CMS ; sync-publications.sh : publications seules.
# Chaque CMS possède ses propres jetons API personnalisés :
# EXPORT : content-sync > export et download.
# IMPORT : content-sync > plan, upload et import.
SYNC_LOCAL_URL=http://localhost:1337
SYNC_LOCAL_EXPORT_TOKEN=
SYNC_LOCAL_IMPORT_TOKEN=

SYNC_RE7_URL=https://vertical-cotiere-admin.re7.jehl.org
SYNC_RE7_EXPORT_TOKEN=
SYNC_RE7_IMPORT_TOKEN=

SYNC_PROD_URL=https://vertical-cotiere-admin.jehl.org
SYNC_PROD_EXPORT_TOKEN=
SYNC_PROD_IMPORT_TOKEN=

# Profil supplémentaire possible : SYNC_STAGING_URL et ses jetons EXPORT/IMPORT.
# Pour des URL libres, ou pour conserver l’ancienne configuration directionnelle :
# SYNC_SOURCE_URL=https://cms-source.example.org
# SYNC_SOURCE_TOKEN=
# SYNC_TARGET_URL=https://cms-cible.example.org
# SYNC_TARGET_TOKEN=
